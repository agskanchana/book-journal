-- Name: books Users can view own books; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Users can view own books" ON public.books FOR SELECT USING ((auth.uid() = user_id));


--
-- Name: user_profiles Users can view own profile; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Users can view own profile" ON public.user_profiles FOR SELECT USING ((auth.uid() = id));


--
-- Name: user_reading_progress Users can view own progress; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Users can view own progress" ON public.user_reading_progress FOR SELECT USING ((auth.uid() = user_id));


